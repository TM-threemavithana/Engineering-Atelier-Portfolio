{
  "name": "engineering-atelier",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ tests/ *.mjs *.json",
    "format:check": "prettier --check src/ tests/ *.mjs *.json",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "verify:primitives": "tsx tests/artifacts/primitives-rendering.ts",
    "verify:project-cards": "tsx tests/artifacts/project-card-rendering.ts",
    "verify:case-studies": "tsx tests/artifacts/case-study-rendering.ts",
    "verify:artifacts": "tsx tests/artifacts/artifact-verification.ts",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run verify:primitives && npm run verify:project-cards && npm run verify:case-studies && npm run build && npm run verify:artifacts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
