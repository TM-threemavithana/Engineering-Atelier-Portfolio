---
import { getVerifiedEmail, getVerifiedProfiles, contactConfig } from '../../data/contact';
import Button from '../ui/Button.astro';
import CopyEmail from './CopyEmail';
import MailIcon from '../icons/MailIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const verifiedEmail = getVerifiedEmail();
const verifiedProfiles = getVerifiedProfiles();
---

<div class:list={['container-atelier space-y-16 sm:space-y-24 pb-20 sm:pb-28', className]}>
  <!-- Direct Email Section -->
  <section
    id="direct-contact"
    aria-labelledby="direct-heading"
    class="scroll-mt-16 sm:scroll-mt-20 space-y-8"
  >
    <div
      class="rounded-[var(--radius-card)] bg-[var(--color-surface)] border border-[var(--color-border)] p-8 sm:p-12 shadow-md relative overflow-hidden"
    >
      <!-- Ambient Accent Glow -->
      <div
        class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[var(--color-accent)]/5 blur-3xl pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="max-w-2xl space-y-6">
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-xl bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-accent)]"
          >
            <MailIcon class="w-5 h-5" />
          </div>
          <div>
            <span
              class="font-['JetBrains_Mono'] text-xs font-semibold text-[var(--color-accent)] uppercase tracking-wider"
            >
              PRIMARY COMMUNICATION
            </span>
            <h2
              id="direct-heading"
              class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold text-[var(--color-fg)]"
            >
              Direct Inquiries
            </h2>
          </div>
        </div>

        <p class="text-[var(--color-muted)] text-base sm:text-lg leading-relaxed">
          The most direct way to reach me regarding engineering architecture, systems discussion, or
          professional inquiries.
        </p>

        {verifiedEmail && <div class="space-y-6 pt-2">
          <!-- Selectable Email Display -->
          <div
            class="inline-flex items-center px-4 py-2.5 rounded-lg bg-[var(--color-surface-alt)] border border-[var(--color-border)] font-['JetBrains_Mono'] text-sm sm:text-base font-medium text-[var(--color-fg)] select-all"
          >
            {verifiedEmail}
          </div>

          <!-- Action Buttons: Direct mailto (zero-JS) & CopyEmail Island -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <Button href={`mailto:${verifiedEmail}`} variant="primary" class="font-semibold">
              <MailIcon class="w-4 h-4 mr-1 shrink-0" />
              Send Email
            </Button>

            <CopyEmail client:idle email={verifiedEmail} />
          </div>
        </div>}

        <div
          class="pt-6 border-t border-[var(--color-border)]/80 text-xs sm:text-sm text-[var(--color-muted)]/80 leading-relaxed"
        >
          <span class="font-semibold text-[var(--color-fg)]/80">Privacy & Transparency Note:</span
          >{' '}
          {contactConfig.privacyNotice}
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Professional Profiles Section -->
  {verifiedProfiles.length > 0 && <section
    id="profiles"
    aria-labelledby="profiles-heading"
    class="scroll-mt-16 sm:scroll-mt-20 space-y-8"
  >
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
        <span
          class="font-['JetBrains_Mono'] text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase"
        >
          PROFESSIONAL PROFILES
        </span>
      </div>
      <h2
        id="profiles-heading"
        class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold text-[var(--color-fg)]"
      >
        Professional Networks
      </h2>
      <p class="text-[var(--color-muted)] text-sm sm:text-base max-w-xl leading-relaxed">
        Public repositories, code samples, and professional engineering background.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {verifiedProfiles.map((profile) => <article
        class="rounded-[var(--radius-card)] bg-[var(--color-surface)] border border-[var(--color-border)] p-6 sm:p-8 flex flex-col justify-between hover:border-[var(--color-accent)]/50 transition-colors shadow-sm"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div
              class="w-10 h-10 rounded-xl bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-fg)]"
            >
              {profile.platform === 'GitHub' ? (
                <GitHubIcon class="w-5 h-5 text-[var(--color-accent)]" />
              ) : (
                <LinkedInIcon class="w-5 h-5 text-[var(--color-accent)]" />
              )}
            </div>
            <span
              class="font-['JetBrains_Mono'] text-xs font-semibold px-2.5 py-1 rounded bg-[var(--color-surface-alt)] border border-[var(--color-border)] text-[var(--color-fg)]/80"
            >
              Profile
            </span>
          </div>

          <h3 class="font-['Space_Grotesk'] text-xl font-bold text-[var(--color-fg)]">
            {profile.platform === 'GitHub' ? 'GitHub' : 'LinkedIn'}
          </h3>

          <div class="font-['JetBrains_Mono'] text-sm text-[var(--color-muted)]">
            {profile.handle}
          </div>

          <p class="text-sm text-[var(--color-muted)] leading-relaxed">
            {profile.description}
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-[var(--color-border)]">
          <Button
            href={profile.url}
            variant="secondary"
            openInNewTab={true}
            class="w-full justify-between"
          >
            <span>Visit {profile.platform} Profile</span>
            <ExternalLinkIcon class="w-4 h-4 ml-1 opacity-70" />
            <span class="sr-only">(opens in a new tab)</span>
          </Button>
        </div>
      </article>)}
    </div>
  </section>}

  <!-- Return to Overview Navigation Section -->
  <section
    id="return-nav"
    aria-labelledby="overview-heading"
    class="scroll-mt-16 sm:scroll-mt-20 pt-8 border-t border-[var(--color-border)]"
  >
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2
          id="overview-heading"
          class="font-['Space_Grotesk'] text-xl font-bold text-[var(--color-fg)]"
        >
          Explore Other Areas
        </h2>
        <p class="text-xs sm:text-sm text-[var(--color-muted)] mt-1">
          Review core backend capabilities or read the engineer's technical background.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <Button href="/" variant="secondary"> Return to Home </Button>
        <Button href="/about/" variant="ghost"> View About </Button>
      </div>
    </div>
  </section>
</div>
