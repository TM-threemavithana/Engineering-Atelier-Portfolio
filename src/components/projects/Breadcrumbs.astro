---
/**
 * @file src/components/projects/Breadcrumbs.astro
 * @description Accessible breadcrumb navigation trail for case studies and subpages.
 *
 * ARCHITECTURAL DESIGN (EA-023):
 * - Semantic <nav aria-label="Breadcrumb"> with <ol> and <li> hierarchy.
 * - Current active terminal breadcrumb marked with aria-current="page".
 * - Visible focus rings (#F0CF78) and monospace typography matching design tokens.
 * - Suppresses dead links by validating link destinations.
 */

import { validateLinkDestination } from '../../utils/linkSafety';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items?: BreadcrumbItem[];
  currentTitle?: string;
  class?: string;
}

const { items, currentTitle, class: className = '' } = Astro.props;

// Default breadcrumb trail if custom items array is not provided
const resolvedItems: BreadcrumbItem[] = items || [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  ...(currentTitle ? [{ label: currentTitle }] : []),
];
---

<nav aria-label="Breadcrumb" class:list={['mb-8 sm:mb-10', className]}>
  <ol
    class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-mono text-[var(--color-muted)]"
  >
    {resolvedItems.map((item, index) => {
      const isLast = index === resolvedItems.length - 1;
      const hasValidLink = Boolean(item.href && validateLinkDestination(item.href).isValid);

      return <li class="inline-flex items-center gap-1.5 sm:gap-2">
        {index > 0 && <span
          class="text-[var(--color-border-strong)] select-none text-xs"
          aria-hidden="true"
        >
          /
        </span>}

        {isLast || !hasValidLink ? (
          <span
            class="text-[var(--color-fg)] font-medium truncate max-w-[220px] sm:max-w-md"
            aria-current={isLast ? 'page' : undefined}
          >
            {item.label}
          </span>
        ) : (
          <a
            href={item.href}
            class="focus-ring rounded-[var(--radius-button)] text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors py-0.5 px-1 -mx-1"
          >
            {item.label}
          </a>
        )}
      </li>;
    })}
  </ol>
</nav>
