---
/**
 * @file src/components/projects/ProjectsEmptyState.astro
 * @description Professional empty-state component for the /projects/ index while zero projects are approved.
 *
 * ARCHITECTURAL DESIGN (EA-022):
 * - Recruiter-friendly, concise copy.
 * - Single clear heading (configurable level, default 'h1' for the empty index page).
 * - Exact approved message without leaking draft names, legal clearances, or internal audits.
 * - Direct working links to /about/ ("Explore Technical Capabilities") and /contact/ ("Get in Touch").
 * - Fully accessible with keyboard navigation and visible focus rings.
 */

import Button from '../ui/Button.astro';
import ArrowRightIcon from '../icons/ArrowRightIcon.astro';

export interface Props {
  headingLevel?: 'h1' | 'h2';
  class?: string;
}

const { headingLevel = 'h1', class: className = '' } = Astro.props;
const HeadingTag = headingLevel;
---

<div
  class:list={[
    'surface-card rounded-[var(--radius-card)] border border-[var(--color-border)] p-8 sm:p-12 lg:p-16 text-center flex flex-col items-center justify-center max-w-3xl mx-auto my-8 relative overflow-hidden',
    className,
  ]}
  data-testid="projects-empty-state"
>
  <!-- Architectural grid watermark / subtle decorative accent -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(var(--color-fg)_1px,transparent_1px)] [background-size:16px_16px]"
    aria-hidden="true"
  ></div>

  <!-- Restrained status pill -->
  <div
    class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-tag)] bg-[var(--color-surface-alt)] border border-[var(--color-border-strong)] text-xs font-mono text-[var(--color-accent)] mb-6 select-none relative z-10"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
    <span>STATUS // CASE_STUDIES_IN_PREPARATION</span>
  </div>

  <!-- Heading: exactly "Engineering Case Studies" -->
  <HeadingTag
    class="font-['Space_Grotesk'] text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--color-fg)] mb-5 relative z-10"
  >
    Engineering Case Studies
  </HeadingTag>

  <!-- Approved exact copy -->
  <p
    class="text-base sm:text-lg text-[var(--color-muted)] leading-relaxed max-w-xl mb-8 relative z-10"
  >
    Detailed project case studies are being prepared. In the meantime, explore my engineering
    approach, technical capabilities, and the systems I focus on building.
  </p>

  <!-- Working action links -->
  <div
    class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto relative z-10"
  >
    <Button href="/about/" variant="primary" size="md" class="w-full sm:w-auto">
      <span>Explore Technical Capabilities</span>
      <ArrowRightIcon class="w-4 h-4 ml-1" />
    </Button>

    <Button href="/contact/" variant="secondary" size="md" class="w-full sm:w-auto">
      <span>Get in Touch</span>
    </Button>
  </div>
</div>
