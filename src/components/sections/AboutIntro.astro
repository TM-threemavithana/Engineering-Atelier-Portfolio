---
import { aboutBio } from '../../data/about';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  id="about-intro"
  aria-labelledby="about-intro-heading"
  class:list={['container-atelier py-12 sm:py-16 lg:py-20', className]}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Left Narrative Column (7 cols desktop) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
        <span
          class="font-['JetBrains_Mono'] text-xs font-semibold tracking-wider text-[var(--color-accent)] uppercase"
        >
          {aboutBio.eyebrow}
        </span>
      </div>

      <h1
        id="about-intro-heading"
        class="font-['Space_Grotesk'] text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--color-fg)] leading-[1.15]"
      >
        {aboutBio.title}
      </h1>

      <p class="text-lg sm:text-xl font-medium text-[var(--color-fg)]/90 leading-relaxed">
        {aboutBio.positioning}
      </p>

      <div class="space-y-4 pt-2 text-[var(--color-muted)] text-base sm:text-lg leading-relaxed">
        {aboutBio.narrative.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <!-- Right Emblem Card / Portrait Fallback Column (5 cols desktop) -->
    <div class="lg:col-span-5 w-full">
      <div
        class="relative rounded-[var(--radius-card)] bg-[var(--color-surface)] border border-[var(--color-border)] p-8 sm:p-10 shadow-lg overflow-hidden group hover:border-[var(--color-accent)]/50 transition-colors"
      >
        <!-- Subtle Background Glow -->
        <div
          class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-[var(--color-accent)]/5 blur-3xl pointer-events-none"
          aria-hidden="true"
        ></div>

        <div
          class="flex items-center justify-between mb-8 pb-4 border-b border-[var(--color-border)]"
        >
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)]"></span>
            <span
              class="font-['JetBrains_Mono'] text-xs text-[var(--color-muted)] uppercase tracking-wider"
            >
              ENGINEERING ATELIER
            </span>
          </div>
          <span class="font-['JetBrains_Mono'] text-xs text-[var(--color-muted)]"> ARCH-01 </span>
        </div>

        <!-- Central Monogram Iconography -->
        <div class="py-10 flex flex-col items-center justify-center text-center space-y-4">
          <div
            class="w-24 h-24 rounded-2xl bg-[var(--color-surface-alt)] border border-[var(--color-border)] flex items-center justify-center text-3xl font-bold font-['Space_Grotesk'] text-[var(--color-fg)] shadow-inner group-hover:border-[var(--color-accent)] transition-colors"
          >
            EA
          </div>
          <div>
            <div class="font-['Space_Grotesk'] text-xl font-bold text-[var(--color-fg)]">
              Engineering Foundations
            </div>
            <p class="font-['JetBrains_Mono'] text-xs text-[var(--color-accent)] mt-1">
              Backend Systems &bull; Concurrency &bull; Web Standards
            </p>
          </div>
        </div>

        <div
          class="mt-6 pt-6 border-t border-[var(--color-border)] grid grid-cols-2 gap-4 text-center"
        >
          <div
            class="p-3 rounded-lg bg-[var(--color-surface-alt)]/60 border border-[var(--color-border)]/60"
          >
            <div class="font-['JetBrains_Mono'] text-[11px] text-[var(--color-muted)] uppercase">
              Primary Core
            </div>
            <div class="font-['Space_Grotesk'] text-sm font-semibold text-[var(--color-fg)] mt-0.5">
              Java Ecosystem
            </div>
          </div>
          <div
            class="p-3 rounded-lg bg-[var(--color-surface-alt)]/60 border border-[var(--color-border)]/60"
          >
            <div class="font-['JetBrains_Mono'] text-[11px] text-[var(--color-muted)] uppercase">
              Architecture
            </div>
            <div class="font-['Space_Grotesk'] text-sm font-semibold text-[var(--color-fg)] mt-0.5">
              Distributed Focus
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
