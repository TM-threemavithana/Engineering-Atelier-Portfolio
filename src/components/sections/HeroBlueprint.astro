---
import Tag from '../ui/Tag.astro';
---

<div
  id="architecture-blueprint"
  tabindex="-1"
  class="surface-card p-5 sm:p-7 rounded-[var(--radius-card)] border border-[var(--color-border)] relative overflow-hidden focus:outline-none focus:ring-2 focus:ring-[var(--color-focus)] transition-colors duration-150 scroll-mt-16 sm:scroll-mt-20"
  role="region"
  aria-labelledby="blueprint-heading"
  aria-describedby="blueprint-summary"
>
  <!-- Background radial subtle glow (nonessential decorative atmospheric sheen) -->
  <div
    class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-[var(--color-accent)]/5 pointer-events-none blur-3xl motion-reduce:hidden"
    aria-hidden="true"
  ></div>

  <!-- Card Header with Restrained Editorial Typography -->
  <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3 mb-5">
    <div class="flex items-center gap-2">
      <span
        class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] shrink-0"
        aria-hidden="true"
      ></span>
      <h2
        id="blueprint-heading"
        class="font-mono text-xs font-semibold tracking-wider text-[var(--color-fg)] uppercase"
      >
        Topology // Ingestion &amp; Consensus
      </h2>
    </div>
    <Tag label="Conceptual Model" variant="accent" size="sm" />
  </div>

  <!-- Accessible Screen-Reader Description of Conceptual Branching Flow -->
  <p id="blueprint-summary" class="sr-only">
    Conceptual architecture diagram illustrating an event ingestion and consensus topology: gRPC
    clients stream payloads into a bounded in-memory buffered channel; the pipeline handler consumes
    batches and routes them to the Raft consensus log; from the consensus log, flow branches
    concurrently into local durable write-ahead log (WAL) storage engine commits and network
    AppendEntries RPC replication to peer replicas across the cluster.
  </p>

  <!-- DESKTOP / TABLET VECTOR SVG (>= 640px) -->
  <div class="hidden sm:block w-full my-2">
    <svg
      viewBox="0 0 540 270"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto overflow-visible select-none"
      role="img"
      aria-label="Conceptual architecture topology diagram"
    >
      <defs>
        <!-- Horizontal Accent Arrowhead Marker -->
        <marker
          id="bp-arrow-accent"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="var(--color-accent, #5EEAD4)" />
        </marker>

        <!-- Vertical Boundary Arrowhead Marker -->
        <marker
          id="bp-arrow-down"
          viewBox="0 0 10 10"
          refX="5"
          refY="8"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M 1.5 0 L 5 8 L 8.5 0 z" fill="var(--color-border-strong, #5A7597)" />
        </marker>
      </defs>

      <!-- ROW 1: INGESTION INGRESS & BUFFERING -->
      <!-- Node 1: Client (gRPC) -->
      <g>
        <rect
          x="12"
          y="12"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="24" y="34" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Client (gRPC)
        </text>
        <text x="24" y="52" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Unary &amp; Stream Ingress
        </text>
      </g>

      <!-- Connector 1 -> 2: Stream Ingress to Buffered Channel -->
      <path
        d="M 212 39 L 320 39"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        stroke-dasharray="4 3"
        marker-end="url(#bp-arrow-accent)"
      />

      <!-- Node 2: Buffered Channel -->
      <g>
        <rect
          x="328"
          y="12"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="340" y="34" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Buffered Channel
        </text>
        <text x="340" y="52" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Bounded In-Memory Queue
        </text>
      </g>

      <!-- Connector 2 -> 3: Buffer down to Pipeline Handler -->
      <path
        d="M 428 66 L 428 88 L 112 88 L 112 104"
        stroke="var(--color-border-strong, #5A7597)"
        stroke-width="1.5"
        fill="none"
        marker-end="url(#bp-arrow-down)"
      />

      <!-- ROW 2: PROCESSING & CONSENSUS LEADER LOG -->
      <!-- Node 3: Pipeline Handler -->
      <g>
        <rect
          x="12"
          y="108"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="24" y="130" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Pipeline Handler
        </text>
        <text x="24" y="148" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Schema Validation &amp; Batching
        </text>
      </g>

      <!-- Connector 3 -> 4: Handler to Consensus Log -->
      <path
        d="M 212 135 L 320 135"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-accent)"
      />

      <!-- Node 4: Consensus Log -->
      <g>
        <rect
          x="328"
          y="108"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-accent)]"
          stroke-width="1.5"
        />
        <text x="340" y="130" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Consensus Log
        </text>
        <text x="340" y="148" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Raft Leader Sequence
        </text>
      </g>

      <!-- BRANCHING CONCURRENT WRITES FROM CONSENSUS LOG -->
      <!-- Branch A (Durable Local Storage): Consensus Log down & left to Storage Engine -->
      <path
        d="M 378 162 L 378 184 L 112 184 L 112 200"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        stroke-dasharray="4 3"
        fill="none"
        marker-end="url(#bp-arrow-down)"
      />
      <text x="210" y="180" class="font-mono text-[9px] fill-[var(--color-muted)] select-none">
        Local Commit (WAL)
      </text>

      <!-- Branch B (Follower Replication): Consensus Log straight down to Peer Replica -->
      <path
        d="M 478 162 L 478 200"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-down)"
      />
      <text x="486" y="184" class="font-mono text-[9px] fill-[var(--color-accent)] select-none">
        RPC Sync
      </text>

      <!-- ROW 3: DURABLE STORAGE & CLUSTER REPLICATION -->
      <!-- Node 5: Storage Engine -->
      <g>
        <rect
          x="12"
          y="204"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="24" y="226" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Storage Engine
        </text>
        <text x="24" y="244" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Immutable WAL &amp; Compaction
        </text>
      </g>

      <!-- Peer State Machine Convergence Line -->
      <path
        d="M 212 231 L 320 231"
        stroke="var(--color-border-strong, #5A7597)"
        stroke-width="1.5"
        stroke-dasharray="3 3"
        marker-end="url(#bp-arrow-accent)"
      />
      <text x="238" y="225" class="font-mono text-[9px] fill-[var(--color-muted)] select-none">
        Quorum State
      </text>

      <!-- Node 6: Peer Replica -->
      <g>
        <rect
          x="328"
          y="204"
          width="200"
          height="54"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="340" y="226" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Peer Replica
        </text>
        <text x="340" y="244" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Follower State Machine
        </text>
      </g>
    </svg>
  </div>

  <!-- MOBILE VECTOR SVG (< 640px, Stacked Architecture Pipeline with Crisp Legible Typography) -->
  <div class="block sm:hidden w-full my-2">
    <svg
      viewBox="0 0 320 460"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto overflow-visible select-none"
      role="img"
      aria-label="Conceptual architecture topology diagram: Mobile View"
    >
      <defs>
        <marker
          id="bp-arrow-m-down"
          viewBox="0 0 10 10"
          refX="5"
          refY="8"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M 1.5 0 L 5 8 L 8.5 0 z" fill="var(--color-accent, #5EEAD4)" />
        </marker>
        <marker
          id="bp-arrow-m-sub"
          viewBox="0 0 10 10"
          refX="5"
          refY="8"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M 1.5 0 L 5 8 L 8.5 0 z" fill="var(--color-border-strong, #5A7597)" />
        </marker>
      </defs>

      <!-- Mobile Node 1: Client (gRPC) -->
      <g>
        <rect
          x="10"
          y="10"
          width="300"
          height="52"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="22" y="32" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Client (gRPC)
        </text>
        <text x="22" y="49" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Unary &amp; Stream Ingress
        </text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <path
        d="M 160 62 L 160 84"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-m-down)"
      />

      <!-- Mobile Node 2: Buffered Channel -->
      <g>
        <rect
          x="10"
          y="92"
          width="300"
          height="52"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="22" y="114" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Buffered Channel
        </text>
        <text x="22" y="131" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Bounded In-Memory Queue
        </text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <path
        d="M 160 144 L 160 166"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-m-down)"
      />

      <!-- Mobile Node 3: Pipeline Handler -->
      <g>
        <rect
          x="10"
          y="174"
          width="300"
          height="52"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="22" y="196" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Pipeline Handler
        </text>
        <text x="22" y="213" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Schema Validation &amp; Routing
        </text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <path
        d="M 160 226 L 160 248"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-m-down)"
      />

      <!-- Mobile Node 4: Consensus Log (Raft Leader) -->
      <g>
        <rect
          x="10"
          y="256"
          width="300"
          height="52"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-accent)]"
          stroke-width="1.5"
        />
        <text x="22" y="278" class="font-mono text-[13px] font-semibold fill-[var(--color-fg)]">
          Consensus Log
        </text>
        <text x="22" y="295" class="font-mono text-[11px] fill-[var(--color-muted)]">
          Raft Leader Sequence
        </text>
      </g>

      <!-- Branching Split: Left to Storage Engine, Right to Peer Replica -->
      <path
        d="M 85 308 L 85 330"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        stroke-dasharray="3 2"
        marker-end="url(#bp-arrow-m-down)"
      />
      <path
        d="M 235 308 L 235 330"
        stroke="var(--color-accent, #5EEAD4)"
        stroke-width="1.5"
        marker-end="url(#bp-arrow-m-down)"
      />

      <!-- Mobile Node 5: Storage Engine -->
      <g>
        <rect
          x="10"
          y="338"
          width="144"
          height="62"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="18" y="360" class="font-mono text-[12px] font-semibold fill-[var(--color-fg)]">
          Storage Engine
        </text>
        <text x="18" y="378" class="font-mono text-[10px] fill-[var(--color-muted)]">
          Immutable WAL
        </text>
        <text x="18" y="392" class="font-mono text-[9.5px] fill-[var(--color-accent)]">
          Local Durable
        </text>
      </g>

      <!-- Mobile Node 6: Peer Replica -->
      <g>
        <rect
          x="166"
          y="338"
          width="144"
          height="62"
          rx="6"
          class="fill-[var(--color-surface-alt)] stroke-[var(--color-border-strong)]"
          stroke-width="1.5"
        />
        <text x="174" y="360" class="font-mono text-[12px] font-semibold fill-[var(--color-fg)]">
          Peer Replica
        </text>
        <text x="174" y="378" class="font-mono text-[10px] fill-[var(--color-muted)]">
          Follower State
        </text>
        <text x="174" y="392" class="font-mono text-[9.5px] fill-[var(--color-accent)]">
          Cluster Sync
        </text>
      </g>
    </svg>
  </div>

  <!-- Card Footer / Honest Metadata -->
  <div
    class="mt-5 pt-3.5 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs font-mono text-[var(--color-muted)]"
  >
    <div class="flex items-center gap-1.5">
      <span class="text-[var(--color-fg)] font-medium">Model:</span>
      <span>Candidate Architecture</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[var(--color-fg)] font-medium">Status:</span>
      <span class="text-[var(--color-accent)] font-medium">Illustrative Architecture</span>
    </div>
  </div>
</div>
