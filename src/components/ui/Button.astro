---
import { validateLinkDestination } from '../../utils/linkSafety';
import SpinnerIcon from '../icons/SpinnerIcon.astro';

export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  isLoading?: boolean;
  openInNewTab?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  isLoading = false,
  openInNewTab = false,
  class: className = '',
} = Astro.props;

// Base shared classes
const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] font-medium select-none min-h-[44px] min-w-[44px] transition-all duration-150 motion-reduce:transition-none motion-reduce:transform-none focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]';

// Size mappings
const sizeClasses = {
  sm: 'px-3.5 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3 text-base font-semibold',
}[size];

// Variant color mappings
const variantClasses = {
  primary:
    'bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold hover:bg-[var(--color-accent-hover)] active:translate-y-px',
  secondary:
    'bg-[var(--color-surface-alt)] text-[var(--color-fg)] border border-[var(--color-border-strong)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] active:translate-y-px',
  ghost:
    'bg-transparent text-[var(--color-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-surface)] active:translate-y-px',
}[variant];

// Disabled & Loading state classes
const disabledClasses =
  disabled || isLoading
    ? 'opacity-50 cursor-not-allowed pointer-events-none hover:bg-auto hover:text-auto'
    : 'cursor-pointer';

const combinedClasses = [baseClasses, sizeClasses, variantClasses, disabledClasses, className]
  .filter(Boolean)
  .join(' ');

// Destination validation if link
const hasHref = typeof href === 'string' && href.length > 0;
const validation = hasHref ? validateLinkDestination(href) : null;
const isLinkValid = validation?.isValid ?? false;
const shouldRenderAsLink = hasHref && isLinkValid && !disabled;
---

{shouldRenderAsLink ? (
  <a
    href={validation?.sanitizedHref}
    target={openInNewTab ? '_blank' : undefined}
    rel={openInNewTab ? 'noopener noreferrer' : undefined}
    class={combinedClasses}
  >
    <slot />
    {openInNewTab && <span class="sr-only"> (opens in new tab)</span>}
  </a>
) : hasHref ? (
  /* Unavailable or disabled link rendered as non-interactive accessible span */
  <span
    role="link"
    aria-disabled="true"
    tabindex="-1"
    class={combinedClasses}
    title={validation?.error}
  >
    <slot />
  </span>
) : (
  /* Native button element */
  <button
    type={type}
    disabled={disabled || isLoading}
    aria-disabled={disabled ? 'true' : undefined}
    aria-busy={isLoading ? 'true' : undefined}
    aria-live={isLoading ? 'polite' : undefined}
    class={combinedClasses}
  >
    {isLoading && (
      <>
        <SpinnerIcon class="w-4 h-4 animate-spin text-current" />
        <span class="sr-only">Loading...</span>
      </>
    )}
    <slot />
  </button>
)}
