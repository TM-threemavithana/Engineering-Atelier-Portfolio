---
export interface Props {
  label: string;
  tone?: 'neutral' | 'accent' | 'warning' | 'success';
  class?: string;
}

const { label, tone = 'neutral', class: className = '' } = Astro.props;

const toneConfigs = {
  neutral: {
    dot: 'bg-[var(--color-border-strong)]',
    text: 'text-[var(--color-muted)]',
    border: 'border-[var(--color-border)]',
  },
  accent: {
    dot: 'bg-[var(--color-accent)]',
    text: 'text-[var(--color-accent)]',
    border: 'border-[var(--color-accent)]/30',
  },
  warning: {
    dot: 'bg-[var(--color-warning)]',
    text: 'text-[var(--color-warning)]',
    border: 'border-[var(--color-warning)]/30',
  },
  success: {
    dot: 'bg-[var(--color-success)]',
    text: 'text-[var(--color-success)]',
    border: 'border-[var(--color-success)]/30',
  },
}[tone];
---

<div
  class:list={[
    'inline-flex items-center gap-2 px-2.5 py-1 rounded-[var(--radius-tag)] bg-[var(--color-surface-alt)] border select-none font-mono text-xs',
    toneConfigs.border,
    toneConfigs.text,
    className,
  ]}
>
  <!-- Static indicator dot: strictly zero animation or pulsing per design contract -->
  <span class:list={['w-1.5 h-1.5 rounded-full shrink-0', toneConfigs.dot]} aria-hidden="true" />
  <span class="font-medium tracking-tight">{label}</span>
</div>
