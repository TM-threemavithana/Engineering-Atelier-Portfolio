---
import { validateLinkDestination } from '../../utils/linkSafety';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';

export interface Props {
  href: string;
  disabled?: boolean;
  openInNewTab?: boolean;
  underline?: 'always' | 'hover';
  showIcon?: boolean;
  class?: string;
}

const {
  href,
  disabled = false,
  openInNewTab = false,
  underline = 'always',
  showIcon = true,
  class: className = '',
} = Astro.props;

const validation = validateLinkDestination(href);
const isLinkValid = validation.isValid && !disabled;

const baseClasses =
  'inline-flex items-center gap-1 font-medium transition-colors duration-150 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)] rounded-sm';

const underlineClasses =
  underline === 'always'
    ? 'underline decoration-[var(--color-accent)] decoration-1 underline-offset-4 hover:decoration-2'
    : 'hover:underline hover:decoration-[var(--color-accent)] hover:underline-offset-4';

const stateClasses = isLinkValid
  ? 'text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] cursor-pointer'
  : 'text-[var(--color-muted)] opacity-50 cursor-not-allowed no-underline pointer-events-none select-none';

const combinedClasses = [baseClasses, underlineClasses, stateClasses, className]
  .filter(Boolean)
  .join(' ');
---

{isLinkValid ? (
  <a
    href={validation.sanitizedHref}
    target={openInNewTab ? '_blank' : undefined}
    rel={openInNewTab ? 'noopener noreferrer' : undefined}
    class={combinedClasses}
  >
    <slot />
    {openInNewTab && (
      <>
        <span class="sr-only"> (opens in new tab)</span>
        {showIcon && <ExternalLinkIcon class="w-3.5 h-3.5 inline-block shrink-0" />}
      </>
    )}
  </a>
) : (
  /* Unavailable or disabled link rendered as non-interactive accessible span */
  <span
    role="link"
    aria-disabled="true"
    tabindex="-1"
    class={combinedClasses}
    title={validation.error}
  >
    <slot />
  </span>
)}
