---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Engineering Atelier — EA-006 Baseline"
  description="Verification baseline for Tailwind CSS v4 global tokens, accessible utilities, and responsive design."
>
  <main id="main-content" tabindex="-1" class="container-atelier py-12 sm:py-16 focus:outline-none">
    <!-- Header Landmark -->
    <header class="border-b border-[var(--color-border-strong)] pb-8 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-tag)] bg-[var(--color-surface-alt)] border border-[var(--color-border-strong)] text-[var(--color-accent)] font-mono text-xs mb-4">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
        <span>EA-006 Global CSS & Accessible Tokens</span>
      </div>
      <h1 class="font-['Space_Grotesk'] text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--color-fg)] mb-4">
        Engineering Atelier
      </h1>
      <p class="reading-column text-[var(--color-muted)] text-base lg:text-lg leading-relaxed">
        Building reliable systems. Creating meaningful experiences. This baseline validates Tailwind CSS v4 global tokens, responsive container gutters, WCAG 2.2 AA/AAA focus appearance, and accessible semantic utilities.
      </p>
    </header>

    <!-- Section 1: Surface Containers & Border Semantics -->
    <section id="semantic-utilities" aria-labelledby="tokens-heading" class="space-y-6 mb-12">
      <div class="flex items-center justify-between">
        <h2 id="tokens-heading" class="font-['Space_Grotesk'] text-2xl font-bold text-[var(--color-fg)]">
          Surface Containers &amp; Border Semantics
        </h2>
        <span class="surface-pill px-2.5 py-0.5 text-xs font-mono text-[var(--color-muted)]">
          WCAG 2.2 SC 1.4.11
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Decorative Border Card -->
        <article class="surface-card p-6">
          <div class="text-xs font-mono text-[var(--color-muted)] uppercase tracking-wider mb-2">
            Decorative Container
          </div>
          <h3 class="text-lg font-bold text-[var(--color-fg)] mb-2">
            Surface Card (.surface-card)
          </h3>
          <p class="text-[var(--color-muted)] text-sm mb-4 leading-relaxed">
            Decorative hairline stroke (<code class="text-xs text-[var(--color-fg)]">#34465D</code>, 1.78:1) with distinct background fill (<code class="text-xs text-[var(--color-fg)]">#111C2B</code>).
          </p>
          <div class="surface-pill inline-block px-2 py-1 text-xs font-mono text-[var(--color-muted)]">
            Fill separation provides boundary
          </div>
        </article>

        <!-- Interactive Card with Safe Hover Media Query -->
        <article class="surface-card-interactive p-6 cursor-pointer">
          <div class="text-xs font-mono text-[var(--color-accent)] uppercase tracking-wider mb-2">
            Interactive Transition
          </div>
          <h3 class="text-lg font-bold text-[var(--color-fg)] mb-2">
            Interactive Card (.surface-card-interactive)
          </h3>
          <p class="text-[var(--color-muted)] text-sm mb-4 leading-relaxed">
            Hover lift (<code class="text-xs text-[var(--color-fg)]">translateY(-4px)</code>) guarded by <code class="text-xs text-[var(--color-fg)]">(hover: hover) and (pointer: fine)</code>.
          </p>
          <div class="surface-pill inline-block px-2 py-1 text-xs font-mono text-[var(--color-accent)]">
            Hover sheen: #94F5E6
          </div>
        </article>

        <!-- Standalone Semantic Boundary Card -->
        <article class="p-6 rounded-[var(--radius-card)] bg-[var(--color-surface)] border border-[var(--color-border-strong)]">
          <div class="text-xs font-mono text-[var(--color-focus)] uppercase tracking-wider mb-2">
            Essential UI Boundary
          </div>
          <h3 class="text-lg font-bold text-[var(--color-fg)] mb-2">
            Strong Boundary (--color-border-strong)
          </h3>
          <p class="text-[var(--color-muted)] text-sm mb-4 leading-relaxed">
            Component boundary (<code class="text-xs text-[var(--color-fg)]">#5A7597</code>, 3.61:1 against surface), exceeding WCAG 2.2 SC 1.4.11 (&ge; 3.0:1).
          </p>
          <div class="surface-pill inline-block px-2 py-1 text-xs font-mono text-[var(--color-focus)]">
            3.61:1 High-contrast boundary
          </div>
        </article>
      </div>
    </section>

    <!-- Section 2: Interactive Controls & Keyboard Focus -->
    <section aria-labelledby="focus-heading" class="surface-card p-6 sm:p-8 space-y-6 mb-12">
      <div>
        <h2 id="focus-heading" class="font-['Space_Grotesk'] text-2xl font-bold text-[var(--color-fg)] mb-2">
          Interactive Controls &amp; Keyboard Focus
        </h2>
        <p class="text-[var(--color-muted)] text-sm sm:text-base leading-relaxed">
          Tab through the controls below to verify visible, unclipped keyboard focus outlines (<code class="text-xs text-[var(--color-focus)]">#F0CF78</code>, 3px solid, 3px offset; 11.35:1 contrast against surface).
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <!-- Semantic Button -->
        <button
          type="button"
          class="focus-ring px-5 py-2.5 rounded-[var(--radius-button)] bg-[var(--color-surface-alt)] text-[var(--color-fg)] border border-[var(--color-border-strong)] hover:border-[var(--color-accent)] font-medium text-sm transition-colors duration-150 cursor-pointer"
        >
          Interactive Button Element
        </button>

        <!-- Secondary Action Button -->
        <button
          type="button"
          class="focus-ring px-5 py-2.5 rounded-[var(--radius-button)] bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm hover:bg-[var(--color-accent-hover)] transition-colors duration-150 cursor-pointer"
        >
          Primary Accent Action
        </button>

        <!-- Semantic Link Element -->
        <a
          href="#semantic-utilities"
          class="focus-ring inline-flex items-center gap-1.5 px-4 py-2 rounded-[var(--radius-button)] text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] font-medium text-sm underline underline-offset-4"
        >
          Back to Utilities Anchor &uarr;
        </a>
      </div>
    </section>

    <!-- Section 3: Responsive Reading Column & Non-JS Resilience -->
    <section aria-labelledby="reading-heading" class="space-y-4">
      <h2 id="reading-heading" class="font-['Space_Grotesk'] text-2xl font-bold text-[var(--color-fg)]">
        Reading Column &amp; Non-JavaScript Resilience
      </h2>
      <div class="reading-column surface-card p-6 space-y-3">
        <p class="text-[var(--color-muted)] text-sm sm:text-base leading-relaxed">
          The <code class="text-xs text-[var(--color-accent)]">.reading-column</code> utility constrains prose line length to 74 characters (<code class="text-xs text-[var(--color-fg)]">max-w-[74ch]</code>), preventing visual fatigue across widescreen monitors.
        </p>
        <p class="text-[var(--color-muted)] text-sm sm:text-base leading-relaxed">
          Zero client-side JavaScript is required to render layout, apply typography, or manage interactive CSS hover and keyboard focus states. All candidate projects remain strictly gated in <code class="text-xs text-[var(--color-warning)]">DRAFT</code> status.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
